# ── Database ────────────────────────────────────────────────────────────────
# MySQL connection string. `npm start` runs `prisma migrate deploy` against it,
# but Hostinger starts the app from server.js: apply migrations there by hand
# (docs/LEAD-AUTOMATION.md, step 1).
DATABASE_URL="mysql://<user>:<password>@<host>:3306/<dbname>"

# ── Admin panel ─────────────────────────────────────────────────────────────
# Owner password for /admin/login (leave the email field empty to use it).
# Also signs every admin session cookie: rotating it logs everyone out.
ADMIN_SECRET=

# ── Email (Resend, for lead notifications) ──────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Site URLs ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://bitsolmarketing.com

# ── Blog API ────────────────────────────────────────────────────────────────
# Key required by POST /api/blog and POST /api/blog-images (publishing scripts).
BLOG_API_KEY=

# ── Admin → Social ──────────────────────────────────────────────────────────
# Set these on the server (Hostinger → environment variables), then redeploy.
# The Social page shows the exact callback URL each app has to allow.
#
# AI that drafts the short post (about 100 words). Free tier, no card needed.
# One key is enough; the others are used only when the first is unavailable.
# AI does not write articles.
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GROQ_API_KEY=          # optional, https://console.groq.com/keys
OPENROUTER_API_KEY=    # optional, https://openrouter.ai/keys
#
# LinkedIn app (linkedin.com/developers/apps) with the Community Management
# API product, and the numeric id of the company page to post to.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_COMPANY_ID=
#
# Facebook app (developers.facebook.com/apps) with Facebook Login added.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Optional: connect only this Page when the account manages several.
# FACEBOOK_PAGE_ID=
# Optional overrides; the defaults are in src/lib/admin/social/.
# LINKEDIN_SCOPES=
# LINKEDIN_API_VERSION=
# FACEBOOK_GRAPH_VERSION=

# ── Admin → Lead Automation ─────────────────────────────────────────────────
# Set these on the server, then redeploy. Admin → Lead Automation → Settings
# shows which are set and the exact URLs to register with Google and Resend.
# Outreach email itself is sent with RESEND_API_KEY (above); who it is sent
# as is chosen in the admin, not here.
#
# Encrypts the stored Google tokens and signs unsubscribe links. Any long
# random string. Without it ADMIN_SECRET is used, and changing the admin
# password would then break unsubscribe links in emails already sent.
AUTOMATION_SECRET=
#
# Google Sheets import. OAuth client of type "Web application" from
# console.cloud.google.com → APIs & Services → Credentials, with the Google
# Sheets API and Google Drive API enabled and this authorised redirect URI:
#   https://bitsolmarketing.com/api/admin/google/callback
# CSV upload works without these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only if the redirect URI must differ from the one above.
# GOOGLE_REDIRECT_URI=
#
# Signing secret of the Resend webhook (resend.com → Webhooks), endpoint:
#   https://bitsolmarketing.com/api/webhooks/resend
# Without it bounces, opens and replies are not detected.
RESEND_WEBHOOK_SECRET=
#
# Enables /api/automation/cron for a cron job on the host, so follow-ups go
# out even when the app was idle. Any long random string. Every minute:
#   curl -fsS -H "Authorization: Bearer <secret>" https://bitsolmarketing.com/api/automation/cron
AUTOMATION_CRON_SECRET=
#
# Optional. "test" records every outreach email without delivering it.
# OUTREACH_EMAIL_MODE=
# Optional. "off" stops the in-process scheduler (cron only).
# AUTOMATION_SCHEDULER=
# "AI Personalize" on a lead drafts one sentence with the AI keys above
# (GEMINI_API_KEY…). A person reads and saves it; nothing is sent unread.

# ── Scripts in scripts/ (run on the office PC, not on the server) ───────────
# Token for the older LinkedIn scripts, from: node scripts/linkedin-auth.mjs
LINKEDIN_ACCESS_TOKEN=
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# scripts/daily-content-automation.mjs is switched off: AI does not write
# articles. "on" switches it back on; it then also reads the optional image
# keys CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN and POLLINATIONS_API_KEY.
# AI_ARTICLE_WRITING=

# ── FTP deployment (only if using deploy.mjs) ───────────────────────────────
FTP_HOST=ftp.bitsolmarketing.com
FTP_USER=
FTP_PASSWORD=
